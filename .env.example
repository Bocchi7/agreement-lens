# Local backend
PORT=4317
PAIR_CODE=246810

# Optional OpenAI-compatible model service.
# Without these values the product remains fully demoable with the evidence-bound local analyzer.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
MODEL_NAME=gpt-4.1-mini
# `chat` uses /chat/completions; `responses` uses OpenAI's native Responses
# API; `gemini` uses Gemini's native generateContent/functionCall format.
# Use `gemini` only with an endpoint/channel that genuinely supports Gemini
# native function calling, rather than an OpenAI-compatible Gemini proxy.
MODEL_API_FORMAT=chat
# `native` lets the model request source/knowledge tools. `inline` sends the
# complete already-collected agreement materials in the model input instead.
# Use `inline` for gateways that expose Gemini text generation but do not
# correctly continue Gemini function-call conversations.
MODEL_TOOL_MODE=native
MODEL_REASONING_EFFORT=low
PROMPT_VERSION=2026-08-23
# Keep model calls alive for a long-running reasoning request. The provider
# may still enforce its own request limit.
MODEL_TIMEOUT_MS=86400000
MODEL_MAX_TOOL_ROUNDS=100
MODEL_MAX_RETRIES=100
# Optional output cap; omit it to use the model provider's native limit.
MODEL_MAX_COMPLETION_TOKENS=
MODEL_VERIFIER_ENABLED=true

# Optional per-role model overrides
MODEL_FEES=
MODEL_PRIVACY=
MODEL_CONTENT=
MODEL_RIGHTS=
MODEL_VERIFIER=
MODEL_MAIN=
MODEL_ROUTER=
