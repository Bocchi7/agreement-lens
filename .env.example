# Local backend
PORT=4317
PAIR_CODE=246810

# Demo model service: Gemini native API.
# Keep the key empty in this example and provide it in your local .env.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
MODEL_NAME=gemini-3.7-flash
# `gemini` uses the official @google/genai SDK and Gemini native API.
# For OpenAI-compatible providers, use OPENAI_BASE_URL and OPENAI_API_KEY
# together with MODEL_API_FORMAT=chat or MODEL_API_FORMAT=responses.
MODEL_API_FORMAT=gemini
# `native` lets the model request source/knowledge tools. `inline` sends the
# complete already-collected agreement materials in the model input. It is an
# intentional offline-material mode, never an automatic fallback for tool errors.
MODEL_TOOL_MODE=native
MODEL_REASONING_EFFORT=low
PROMPT_VERSION=2026-08-23
# Keep model calls alive for a long-running reasoning request. The provider
# may still enforce its own request limit.
MODEL_TIMEOUT_MS=86400000
MODEL_MAX_TOOL_ROUNDS=100
MODEL_MAX_RETRIES=100
# Optional output cap; omit it to use the model provider's native limit.
MODEL_MAX_COMPLETION_TOKENS=
MODEL_VERIFIER_ENABLED=true

# Optional per-role model overrides
MODEL_FEES=
MODEL_PRIVACY=
MODEL_CONTENT=
MODEL_RIGHTS=
MODEL_VERIFIER=
MODEL_MAIN=
MODEL_ROUTER=
