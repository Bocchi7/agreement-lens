{
  "name": "@agreement-lens/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "knowledge:import": "pnpm build && node dist/import-knowledge.js",
    "evaluate": "pnpm build && node dist/evaluate.js"
  },
  "dependencies": {
    "@agreement-lens/agent-core": "workspace:*",
    "@agreement-lens/shared": "workspace:*",
    "@fastify/cors": "^10.1.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.5.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "^5.4.54",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.17.2",
    "tsx": "^4.20.4"
  }
}
