{
  "name": "agreement-lens",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm build && pnpm --parallel --filter @agreement-lens/server --filter @agreement-lens/extension dev",
    "server:start": "pnpm build && node apps/server/dist/index.js",
    "server:background": "pnpm build && node scripts/server-control.mjs start",
    "server:stop": "node scripts/server-control.mjs stop",
    "server:status": "node scripts/server-control.mjs status",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "knowledge:import": "pnpm --filter @agreement-lens/server knowledge:import",
    "evaluate": "pnpm --filter @agreement-lens/server evaluate"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
